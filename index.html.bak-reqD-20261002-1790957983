<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>小蜘蛛桌宠</title>

<!-- ===== iOS 全屏（加到主屏幕后不再有 Safari 界面）===== -->
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, minimum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="小蜘蛛">
<meta name="theme-color" content="#F5F0E6">
<meta name="format-detection" content="telephone=no,date=no,address=no,email=no">
<link rel="apple-touch-icon" href="icons/apple-touch-icon.png">
<link rel="icon" href="icons/favicon.png">
<link rel="manifest" href="manifest.webmanifest">

<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  html, body {
    position:fixed; inset:0; width:100%; height:100%;
    overflow:hidden; overscroll-behavior:none;
    /* ★ 触屏基础（需求3）：双击不缩放、长按不弹菜单、不选中文字、不出现点击高亮 */
    touch-action:none;
    -webkit-user-select:none; user-select:none;
    -webkit-touch-callout:none; -webkit-tap-highlight-color:transparent;
    background:#F5F0E6;
    font-family:-apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  }
  /* ★ 2026-09-30：背景改成**米白**（用户要求）。
     原来是「深色房间」的深蓝渐变。改浅之后，所有叠在背景上的 UI
     （顶栏按钮 / 表情面板 / 提示文字）都从「浅色字 + 半透明白底」
     翻成「深色字 + 半透明白底」，否则在米白上会糊成一片看不清。 */
  #bg {
    position:absolute; inset:0;
    background:
      radial-gradient(125% 78% at 50% 4%,  #FFFDF8 0%, #F7F2E7 34%, #F2ECDD 62%, #EAE3D2 100%);
  }
  /* 地面的一点暖色投影，让人物不是悬空贴在浅底上 */
  #bg::after {
    content:""; position:absolute; left:0; right:0; bottom:0; height:46%;
    background:radial-gradient(60% 100% at 50% 100%, rgba(120,98,64,.16) 0%, rgba(120,98,64,0) 70%);
  }
  #cv { position:absolute; inset:0; display:block; width:100%; height:100%; }

  #safe { position:absolute; top:0; left:0; height:0; visibility:hidden; pointer-events:none;
          padding-top:env(safe-area-inset-top); padding-bottom:env(safe-area-inset-bottom); }

  /* 台词气泡：跟着角色头顶走，位置由 JS 算 */
  #bubble {
    position:absolute; left:50%; transform:translateX(-50%);
    max-width:min(84vw, 460px); padding:10px 14px;
    background:rgba(255,255,255,.95); color:#14213D;
    font-size:16px; line-height:1.45; text-align:center;
    border-radius:16px; border:1px solid rgba(20,33,61,.14);
    box-shadow:0 8px 26px rgba(0,0,0,.32);
    opacity:0; transition:opacity .2s ease, transform .2s ease;
    pointer-events:none; z-index:30;
  }
  #bubble.on { opacity:1; }
  #bubble::after {
    content:""; position:absolute; left:50%; bottom:-7px; margin-left:-7px;
    width:0; height:0; border:7px solid transparent; border-top-color:rgba(255,255,255,.95); border-bottom:0;
  }

  /* ---------------------------------------------------------------
     顶栏（需求4/5/6）：✋拖拽 / 👁吸引转头 · ♪音乐 · 😊表情 · ⟲复位
     ★ 触屏目标尺寸：每个 44x44（iOS HIG 建议的最小可点面积）
     --------------------------------------------------------------- */
  /* ★ 顶栏改横排一行（需求3/4/5/6 的 4 个键）：
     竖屏手机上「竖排 4 个 44px 按钮」要占掉右边一整条 206px 高的空间，
     角色的脸正好被挤在那一条上；横排只占顶部 44px，观感和点按都更好。
     4 * 44 + 3 * 8 = 200px 宽，412px 宽的屏幕上放得下。 */
  #bar {
    position:absolute; right:calc(10px + env(safe-area-inset-right)); z-index:40;
    top:calc(10px + env(safe-area-inset-top));
    display:flex; flex-direction:row; gap:8px;
    align-items:center;
  }
  #bar button {
    width:44px; height:44px; border:0; border-radius:50%;
    background:rgba(255,255,255,.72); color:#3A3226; font-size:19px; line-height:1;
    -webkit-backdrop-filter:blur(8px); backdrop-filter:blur(8px);
    border:1px solid rgba(58,50,38,.16); opacity:.82;
    touch-action:manipulation; font-family:inherit;
    display:flex; align-items:center; justify-content:center;
    transition:background .15s ease, opacity .15s ease, transform .1s ease;
  }
  #bar button:active { opacity:1; transform:scale(.92); }
  /* 点亮态：拖拽=中性，吸引转头/音乐开/表情锁定都点亮成蓝色，一眼能看出当前状态 */
  #bar button.on {
    opacity:1; background:#4A76DC;
    border-color:#6C93E8; color:#FFFFFF;
    box-shadow:0 0 0 2px rgba(74,118,220,.22);
  }

  /* 表情栏（需求6）：挂在顶栏正下方，右侧对齐；两列排布，尽量少占地 */
  #emojiPanel {
    position:absolute; right:calc(10px + env(safe-area-inset-right)); z-index:45;
    top:calc(10px + env(safe-area-inset-top) + 44px + 8px);
    width:min(214px, 58vw); max-height:min(62vh, 430px); overflow-y:auto;
    -webkit-overflow-scrolling:touch;
    background:rgba(255,253,247,.94);
    -webkit-backdrop-filter:blur(14px); backdrop-filter:blur(14px);
    border:1px solid rgba(58,50,38,.14); border-radius:16px;
    padding:8px; display:none; box-shadow:0 12px 34px rgba(90,74,48,.18);
    /* 两列自适应：条目窄的时候自动并排 */
    grid-template-columns:1fr 1fr; gap:4px;
  }
  #emojiPanel.on { display:grid; }
  #emojiPanel .hd {
    grid-column:1 / -1;
    color:rgba(58,50,38,.60); font-size:11px; line-height:1.5;
    padding:2px 6px 6px; text-align:center;
  }
  #emojiPanel .item {
    width:100%; display:flex; flex-direction:column; align-items:flex-start; gap:1px;
    padding:8px 9px; border:0; border-radius:10px;
    background:rgba(58,50,38,.06); color:#3A3226;
    font-size:13px; font-family:inherit; text-align:left;
    touch-action:manipulation; min-height:44px; justify-content:center;
  }
  #emojiPanel .item .pin { font-size:10px; opacity:.5; }
  #emojiPanel .item:active { background:rgba(58,50,38,.14); }
  /* 常驻锁定态 */
  #emojiPanel .item.on {
    background:#4A76DC; color:#fff;
    box-shadow:inset 0 0 0 1px rgba(108,147,232,.6);
  }
  #emojiPanel .item.on .pin { opacity:1; }

  #hint {
    position:absolute; left:50%; transform:translateX(-50%);
    bottom:calc(16px + env(safe-area-inset-bottom));
    color:rgba(58,50,38,.58); font-size:13px; letter-spacing:.4px;
    transition:opacity .8s ease; pointer-events:none; z-index:20;
    text-align:center; width:92%; line-height:1.5;
  }
  #hint.off { opacity:0; }

  #err {
    position:absolute; left:12px; right:12px; top:calc(16px + env(safe-area-inset-top));
    background:rgba(255,255,255,.94); color:#B3261E; font-size:13px; line-height:1.5;
    padding:10px 12px; border-radius:12px; display:none; z-index:50;
  }
</style>
</head>
<body>

<div id="bg"></div>
<canvas id="cv"></canvas>
<div id="safe"></div>
<div id="bubble"></div>
<div id="err"></div>
<div id="bar">
  <button id="btnReset" title="回到原位">⟲</button>
  <button id="btnMusic" title="音乐开 / 关">♪</button>
  <button id="btnEmoji" title="表情栏">😊</button>
  <button id="btnHold" title="拖拽 / 吸引转头">✋</button>
</div>

<!-- 表情栏（需求6）：轻点=演一次，长按=常驻锁定 -->
<div id="emojiPanel">
  <div class="hd">轻点＝演一次<br>长按＝常驻锁定</div>
</div>

<div id="hint">轻戳一下 · 按住拖动 · 双指缩放 · 右上角可切「吸引转头」</div>

<script src="lib/live2dcubismcore.min.js"></script>
<script src="lib/pixi.min.js"></script>
<script src="lib/pixi-live2d-display.min.js"></script>
<script>
/* =========================================================================
   iPhone / iPad 网页版桌宠
   —— 招式库 / 台词表 / 眼型规则全部沿用安卓版内核（同一份，同一个性格）。
      改掉的只有「形态」：
        · iOS 不允许第三方悬浮窗，所以做成全屏网页 App（加到主屏幕后没有浏览器界面）
        · 有背景、有地面光晕（悬浮窗版是透明的）
        · 触摸：轻戳 = 戳一下，单指拖 = 挪位置，双指 = 缩放，位置大小会记住
   ========================================================================= */
(function () {
  'use strict'

  var errEl  = document.getElementById('err')
  var bubble = document.getElementById('bubble')
  var hintEl = document.getElementById('hint')
  var safeEl = document.getElementById('safe')
  var bubbleTimer = 0

  function warn(m) { console.log('[桌宠] ' + m) }
  var warnedOnce = {}
  function warnOnce(m) { if (warnedOnce[m]) return; warnedOnce[m] = 1; warn(m) }
  function fatal(m) { errEl.style.display = 'block'; errEl.textContent = m; console.error('[桌宠] ' + m) }

  /* ★ 眼型下限：0 是全闭（允许），0.3~1 是半闭到全睁。
        0 < 开眼度 < 0.3 在这只模型上就是「眼白只剩一条小缝」，不要。 */
  var EYE_OPEN_MIN = 0.3
  var EYE_IDS = { ParamEyeLOpen: 1, ParamEyeROpen: 1 }
  function clampEye(id, v) {
    if (EYE_IDS[id] && v > 0 && v < EYE_OPEN_MIN) return EYE_OPEN_MIN
    return v
  }

  /* ---------------- 角色：只有小蜘蛛（需求1：不要切换模型） ----------------
     ★ 这里刻意保留成数组形态：以后真想再加一个模型，往里面加一行就行，
       但**界面上不提供任何切换入口**，永远用第 0 个。 */
  var MODELS = [
    { name: '小蜘蛛', url: 'models/cmo4/小蜘蛛cmo4.model3.json' }
  ]
  var mi = 0   // 恒为 0

  /* ---------------- 招式库（自由活动） ---------------- */
  var ACT_LIB = {
    plain: { label: '面无表情', dur: 2.0, params: { ParamEyeLSmile: 0, ParamEyeRSmile: 0 } },
    smile: { label: '微笑', dur: 2.6, params: { ParamEyeLSmile: 1, ParamEyeRSmile: 1, ParamMouthForm: 1 } },
    smileL: { label: '左眼笑', dur: 2.4, params: { ParamEyeLSmile: 1, ParamEyeRSmile: 0, ParamMouthForm: 1 } },
    smileR: { label: '右眼笑', dur: 2.4, params: { ParamEyeLSmile: 0, ParamEyeRSmile: 1, ParamMouthForm: 1 } },
    grin: { label: '笑眯了眼', dur: 2.6, params: { ParamEyeLSmile: 1, ParamEyeRSmile: 1, ParamEyeLOpen: 0.45, ParamEyeROpen: 0.45, ParamMouthForm: 1 } },
    winkL: { label: '左眼眨一下', dur: 1.5, params: { ParamEyeLOpen: 0, ParamEyeLSmile: 0, ParamEyeRSmile: 0, ParamMouthForm: 1 } },
    winkR: { label: '右眼眨一下', dur: 1.5, params: { ParamEyeROpen: 0, ParamEyeRSmile: 0, ParamEyeLSmile: 0, ParamMouthForm: 1 } },
    squintL: { label: '左眼半眯', dur: 2.2, params: { ParamEyeLOpen: 0.35, ParamEyeLSmile: 0, ParamEyeROpen: 1, ParamEyeRSmile: 0 } },
    squintR: { label: '右眼半眯', dur: 2.2, params: { ParamEyeROpen: 0.35, ParamEyeRSmile: 0, ParamEyeLOpen: 1, ParamEyeLSmile: 0 } },
    wide: { label: '睁大眼睛', dur: 1.8, params: { ParamEyeLSmile: 0, ParamEyeRSmile: 0, ParamBrowLY: 0.7, ParamBrowRY: 0.7 } },
    nod: { label: '点头', dur: 2.4, sway: [{ id: 'ParamAngleY', amp: 13, freq: 1.5 }] },
    shake: { label: '摇头', dur: 2.8, sway: [{ id: 'ParamAngleX', amp: 19, freq: 1.15 }] },
    wobble: { label: '晃脑', dur: 3.4, sway: [{ id: 'ParamAngleZ', amp: 14, freq: 0.85 }, { id: 'ParamBodyAngleZ', amp: 7, freq: 0.85 }] },
    swayBody: { label: '扭扭身子', dur: 3.6, sway: [{ id: 'ParamBodyAngleX', amp: 7, freq: 0.7 }, { id: 'ParamAngleX', amp: 11, freq: 0.7 }] },
    tilt: { label: '歪头看你', dur: 3.0, params: { ParamAngleZ: 17, ParamAngleX: -8, ParamEyeLOpen: 0.8, ParamEyeLSmile: 0, ParamEyeRSmile: 0 } },
    lookUp: { label: '抬头望天', dur: 3.0, params: { ParamAngleY: 16, ParamAngleZ: -9, ParamEyeLOpen: 0.55, ParamEyeROpen: 0.55, ParamEyeLSmile: 0, ParamEyeRSmile: 0 } },
    shy: { label: '有点不好意思', dur: 2.6, params: { ParamAngleX: -12, ParamAngleZ: 10, ParamEyeLOpen: 0.4, ParamEyeROpen: 0.4, ParamEyeLSmile: 0, ParamEyeRSmile: 0 } },
  }
  var ACT_COMBOS = {
    greet: { label: '打招呼', steps: ['nod', 'smile'] },
    shakeWobble: { label: '摇头晃脑', steps: ['shake', 'wobble'] },
    mischief: { label: '调皮', steps: ['squintL', 'smileR'] },
    cute: { label: '卖萌', steps: ['tilt', 'grin', 'plain'] },
  }
  var FREE_DEFAULT = ['nod', 'shake', 'wobble', 'swayBody', 'smileL', 'smileR', 'winkL', 'winkR',
    'squintL', 'squintR', 'grin', 'plain', 'tilt', 'lookUp', 'shy',
    'greet', 'shakeWobble', 'mischief', 'cute']

  /* ---------------- 点击反应库 ---------------- */
  var REACT_LIB = {
    shyHide: { label: '闭上眼快速摇头', dur: 1.1, in: 0.12, out: 0.32, hop: false,
      params: { ParamEyeLOpen: 0, ParamEyeROpen: 0, ParamEyeLSmile: 0, ParamEyeRSmile: 0 },
      sway: [{ id: 'ParamAngleX', amp: 20, freq: 3.4 }, { id: 'ParamBodyAngleX', amp: 6, freq: 3.4 }] },
    tiltStare: { label: '歪头睁大眼睛', dur: 1.9, in: 0.22, out: 0.4, hop: false,
      params: { ParamAngleZ: 20, ParamAngleX: -6, ParamAngleY: 4, ParamEyeLOpen: 1, ParamEyeROpen: 1, ParamEyeLSmile: 0, ParamEyeRSmile: 0 },
      sway: [{ id: 'ParamAngleZ', amp: 3, freq: 0.6 }] },
    nodYes: { label: '点头', dur: 1.1, in: 0.14, out: 0.28, hop: false,
      sway: [{ id: 'ParamAngleY', amp: 16, freq: 2.8 }] },
    shakeNo: { label: '摇头', dur: 1.2, in: 0.14, out: 0.3, hop: false,
      /* ★ 2026-10-02 用户指定：摇头要「快速多次摇」—— freq 5 × 1.2s ≈ 6 个来回 */
      params: { ParamEyeLSmile: 0, ParamEyeRSmile: 0 },
      sway: [{ id: 'ParamAngleX', amp: 22, freq: 5 }] },
    winkBack: { label: '眨回去', dur: 1.0, in: 0.12, out: 0.3, hop: true,
      params: { ParamEyeLOpen: 0, ParamEyeLSmile: 0, ParamEyeRSmile: 0 } },
    coverFace: { label: '低头捂脸', dur: 1.8, in: 0.25, out: 0.4, hop: false,
      params: { ParamEyeLOpen: 0, ParamEyeROpen: 0, ParamEyeLSmile: 0, ParamEyeRSmile: 0, ParamAngleY: -14, ParamAngleX: -8 } },
    peek: { label: '偷看你', dur: 1.7, in: 0.2, out: 0.4, hop: false,
      params: { ParamEyeLOpen: 0.45, ParamEyeROpen: 1, ParamEyeLSmile: 0, ParamEyeRSmile: 0 },
      sway: [{ id: 'ParamAngleZ', amp: 4, freq: 0.5 }] },
    startle: { label: '吓一跳', dur: 0.9, in: 0.1, out: 0.3, hop: true, hopAmp: 34,
      params: { ParamEyeLOpen: 1, ParamEyeROpen: 1, ParamEyeLSmile: 0, ParamEyeRSmile: 0 },
      sway: [{ id: 'ParamAngleY', amp: 9, freq: 3 }] },
    wiggle: { label: '扭一扭', dur: 1.6, in: 0.2, out: 0.35, hop: false,
      sway: [{ id: 'ParamBodyAngleZ', amp: 9, freq: 2 }, { id: 'ParamAngleZ', amp: 7, freq: 2 }] },
    /* ★ 用户明确要求：闭眼微笑就写 0（全闭），不要 0.3~0.4 那种「一条缝」 */
    happyMelt: { label: '闭眼微笑', dur: 1.9, in: 0.25, out: 0.45, hop: false,
      params: { ParamEyeLOpen: 0, ParamEyeROpen: 0, ParamEyeLSmile: 1, ParamEyeRSmile: 1 },
      sway: [{ id: 'ParamAngleZ', amp: 9, freq: 0.9 }] },
    lookUpAt: { label: '抬头看你', dur: 1.6, in: 0.2, out: 0.4, hop: false,
      params: { ParamAngleY: 18, ParamAngleZ: -8, ParamEyeLOpen: 1, ParamEyeROpen: 1, ParamEyeLSmile: 0, ParamEyeRSmile: 0 } },
    smirkL: { label: '单眼笑', dur: 1.4, in: 0.18, out: 0.34, hop: true,
      params: { ParamEyeLSmile: 0, ParamEyeRSmile: 1, ParamAngleZ: 8 } },
    /* ★ 2026-09-29 新增：凶狠（双眼半眯）
       口径直接对齐桌面版 renderer.js 的 squint：
         squintL/R: ParamEyeLOpen 0.35 + Smile 0（不笑，另眼 Open 1）
         idleEyes : Smile 0（待机不笑，2026-10-02 用户指定）
       所以「凶狠」= Open 0.35 + Smile 0（不笑），两眼一致。
       实测与用户给的参考图⑤按脸宽归一后逐像素比对，0.35 比 0.30/0.40 都更贴合
       （0.30 太细成一条缝，0.40 眼白偏大）。 */
    fierce: { label: '凶狠', dur: 2.2, in: 0.18, out: 0.4, hop: false,
      params: { ParamEyeLOpen: 0.35, ParamEyeROpen: 0.35, ParamEyeLSmile: 0, ParamEyeRSmile: 0 } },
    /* ★ 「瞪眼」：2026-10-02 用户指定 = 左右眼开合 0.5、两眼 Smile 0（不笑）。
       （2026-09-30 版本是 Open=1 全睁，2026-10-02 起改为 0.5 半睁。） */
    glare: { label: '瞪眼', dur: 2.4, in: 0.16, out: 0.4, hop: false,
      params: { ParamEyeLOpen: 0.5, ParamEyeROpen: 0.5, ParamEyeLSmile: 0, ParamEyeRSmile: 0 } },
    /* ★ cmo4 专属表情层：覆盖贴图参数，纯 0/1 切换（黑脸/流泪/脸红/生气/疑问/震惊）。
       用户要求：全部「快速变化」，参数基本只取 0 和 1，触发瞬间 snap 过去。
       故 in 给得很小（0.08s）、out 也快（0.15s 快收）；不挂 sway、不混眼型，让贴图层自己说话。
       轻点演 1~1.4s 自动消失；长按锁定时由 onFrame 末尾常驻写 1。
       ★ 归零由 flushActs 兜底（演出到点 / 被连点打断 / 切换锁定，三条路都把覆盖层参数写回 0），
         严禁任何路径把 black/ll/rl/fr/Param/Param2/Param3 长时间留在中间值。 */
    black: { label: '黑脸', dur: 1.0, in: 0.08, out: 0.15, hop: false,
      params: { black: 1 } },
    cry: { label: '流泪', dur: 1.4, in: 0.08, out: 0.15, hop: false,
      params: { ll: 1, rl: 1 } },
    blush: { label: '脸红', dur: 1.2, in: 0.08, out: 0.15, hop: false,
      params: { fr: 1 } },
    angry: { label: '生气', dur: 1.3, in: 0.08, out: 0.15, hop: false,
      params: { Param: 1 } },
    doubt: { label: '疑问', dur: 1.3, in: 0.08, out: 0.15, hop: false,
      params: { Param2: 1 } },
    shock: { label: '震惊', dur: 1.3, in: 0.08, out: 0.15, hop: false,
      params: { Param3: 1 } },
  }
  var REACT_COMBOS = {
    pokeBack: { label: '回敬一个 wink', steps: ['shakeNo', 'winkBack'] },
    shyPair: { label: '先捂脸再偷看', steps: ['coverFace', 'peek'] },
  }
  var REACT_DEFAULT = ['smile', 'winkR', 'glare', 'shakeNo',
    'black', 'cry', 'blush', 'angry', 'doubt', 'shock']

  var ALL_ACTS = {}, ALL_COMBOS = {}, k
  for (k in ACT_LIB) ALL_ACTS[k] = ACT_LIB[k]
  for (k in REACT_LIB) ALL_ACTS[k] = REACT_LIB[k]
  for (k in ACT_COMBOS) ALL_COMBOS[k] = ACT_COMBOS[k]
  for (k in REACT_COMBOS) ALL_COMBOS[k] = REACT_COMBOS[k]

  /* ---------------- 台词（汤姆·赫兰德那版蜘蛛侠的语气） ---------------- */
  var ACT_SAY = {
