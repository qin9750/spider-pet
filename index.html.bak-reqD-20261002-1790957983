    try { core.getParameterValueById('ParamAngleX'); o.hasReadById = true } catch (e) { }
    try { core.getParameterValueByIndex(0); o.hasReadByIndex = true } catch (e) { }
    for (var i = 0; i < names.length; i++) {
      var id = names[i]
      o.list.push({
        id: id,
        inPI: !!PI[id],
        min: PI[id] ? PI[id].min : null,
        max: PI[id] ? PI[id].max : null,
        def: PI[id] ? PI[id].def : null,
        val: readP(id),
      })
    }
    var all = []
    for (var k in PI) all.push(k + '(' + PI[k].i + ':' + PI[k].min + '~' + PI[k].max + ' def' + PI[k].def + ')')
    o.allNames = all
    return o
  }
  /* 视线追随计算过程转储，排查用 */
  window.__holdDebug = function () {
    return {
      hold: holdMode,
      active: gaze.active, k: Math.round(gaze.k * 1000) / 1000,
      tx: Math.round(gaze.tx), ty: Math.round(gaze.ty),
      ux: Math.round(gy.ux * 1000) / 1000, uy: Math.round(gy.uy * 1000) / 1000,
      tAX: Math.round(gy.tAX * 10) / 10, tAY: Math.round(gy.tAY * 10) / 10,
      modelX: Math.round(model ? model.x : 0), modelY: Math.round(model ? model.y : 0),
      baseY: Math.round(RT.baseY), viewOx: Math.round(view.ox), viewOy: Math.round(view.oy),
      angleX: readP('ParamAngleX'), angleY: readP('ParamAngleY'), angleZ: readP('ParamAngleZ'),
      lSmile: readP('ParamEyeLSmile'), rSmile: readP('ParamEyeRSmile'),
      hasEyeBall: !!PI.ParamEyeBallX,      W: Math.round(app.screen.width), H: Math.round(app.screen.height),
    }
  }

  /* =========================================================================
     联网优先更新（需求2：网页随时联网更新，不会保留之前旧版本）
     —— 只靠 sw.js 做 network-first 还不够：浏览器**本身的 HTTP 缓存**也会
        把 index.html 留住，而且新 SW 装好之后要等所有页面关掉才生效。
        所以这里三件事一起做：
          ① register 时 updateViaCache:'none' → sw.js 自己也不许走 HTTP 缓存
          ② 每次启动主动 reg.update() → 有新 SW 立刻装
          ③ 新 SW 接管（controllerchange）→ **自动刷新一次**，用户看到的就是最新版
        ★ 刷新只做一次（reloaded 标志），否则新旧 SW 互相抢会死循环刷新。
     ========================================================================= */
  if ('serviceWorker' in navigator) {
    var reloaded = false
    navigator.serviceWorker.addEventListener('controllerchange', function () {
      if (reloaded) return
      reloaded = true
      warn('检测到新版本，自动刷新一次')
      location.reload()
    })
    window.addEventListener('load', function () {
      navigator.serviceWorker.register('sw.js', { updateViaCache: 'none' }).then(function (reg) {
        try { reg.update() } catch (e) { }
        /* 回到前台时再查一次：加到主屏幕的 PWA 常常是「切回来」而不是「重新打开」 */
        document.addEventListener('visibilitychange', function () {
          if (document.visibilityState === 'visible') { try { reg.update() } catch (e) { } }
        })
      }).catch(function (e) {
        console.log('[桌宠] 离线缓存没启用（不影响使用）：' + e.message)
      })
      /* 顺手兜一个「有网就直接拿最新的 index.html」：即使是第一次来、
         SW 还没接管，也不会读到代理/CDN 上的旧壳。 */
      fetch('index.html', { method: 'HEAD', cache: 'no-store' }).catch(function () { })
    })
  }
})()
</script>
